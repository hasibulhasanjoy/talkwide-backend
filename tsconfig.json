{
  "compilerOptions": {
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "rootDir": "src",
    "outDir": "dist",

    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,
    "noImplicitReturns": true,

    "noEmitOnError": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "ts-node": {
    "esm": true
  },
  "include": ["src"]
}
